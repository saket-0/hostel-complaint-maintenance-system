# ==============================================================================
# HCMS Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/hcms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USER=hcms
DB_PASSWORD=hcmspass
DB_POOL_SIZE=10

# Server Configuration
PORT=8080
APP_PROFILE=dev

# JWT Security
JWT_SECRET=vit-hcms-2026-very-secure-jwt-secret-key-production-ready
JWT_EXPIRY_SECONDS=86400

# SLA Engine Configuration (in hours)
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168
SLA_ESCALATION_CHECK_MINUTES=15
SLA_AUTO_CLOSE_DAYS=7

# Optional SMTP Mail Notification
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@hcms.vit.ac.in
SMTP_PASSWORD=
